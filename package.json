{
  "name": "@kvmoonshot/trial-sdk-starter",
  "version": "0.7.0",
  "private": true,
  "description": "KVMoonShot Trial SDK - cross-venue strategy integration starter",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "node config/platform-bindings.cjs --install",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:dev": "electron .",
    "desktop:pack": "electron-builder --config electron-builder.yml",
    "desktop:pack:win": "electron-builder --win --config electron-builder.yml",
    "desktop:pack:mac": "electron-builder --mac --config electron-builder.yml",
    "desktop:pack:linux": "electron-builder --linux --config electron-builder.yml",
    "desktop:pack:release": "npm run build && electron-builder --win zip --mac zip --config electron-builder.yml",
    "build:runtime-sync-release": "node scripts/build-runtime-sync-release.mjs",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "clsx": "^2.1.1",
    "ethers": "^6.13.4",
    "lucide-react": "^0.468.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0",
    "zod": "^3.23.8",
    "@kvmoonshot/kvmswap-native": "1.4.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "packageManager": "npm@10.9.8"
}
